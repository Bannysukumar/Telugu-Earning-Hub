rules_version = '2';
/**
 * Client SDK is not used for Firestore in this app (data goes through the API + Admin SDK).
 * Keep documents locked from direct browser access unless you intentionally add user-scoped rules.
 *
 * Collections used by deposits / QR settings: paymentSettings, deposits — still API-only.
 */
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if false;
    }
  }
}

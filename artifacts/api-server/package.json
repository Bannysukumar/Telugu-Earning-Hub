{
  "name": "@workspace/api-server",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "cross-env NODE_ENV=development node ./dev-watch.mjs",
    "build": "node ./build.mjs",
    "start": "node --enable-source-maps ./dist/index.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "node --import tsx --test src/lib/investment-mlm-binary.test.ts src/lib/level-income.test.ts src/lib/level-income-config.test.ts src/lib/investment-cap.test.ts",
    "sponsor:backfill": "tsx ./scripts/backfill-root-sponsor.ts",
    "company:seed": "tsx ./scripts/seed-company-permits.ts --",
    "company:report": "tsx ./scripts/report-company-permits.ts --",
    "firebase:reset": "tsx ./scripts/reset-firebase-project.ts --",
    "plans:seed": "tsx ./scripts/seed-standard-plans.ts --",
    "users:delete": "tsx ./scripts/delete-users-by-email.ts --",
    "settings:min-withdrawal": "tsx ./scripts/set-min-withdrawal.ts --"
  },
  "dependencies": {
    "@workspace/api-zod": "workspace:*",
    "cookie-parser": "^1.4.7",
    "cors": "^2",
    "express": "^5",
    "express-session": "^1.19.0",
    "firebase-admin": "^13.5.0",
    "multer": "^2.1.1",
    "pino": "^9",
    "pino-http": "^10",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@types/cookie-parser": "^1.4.10",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/multer": "^2.1.0",
    "@types/node": "catalog:",
    "cross-env": "^7.0.3",
    "esbuild": "^0.27.3",
    "esbuild-plugin-pino": "^2.3.3",
    "pino-pretty": "^13",
    "thread-stream": "3.1.0",
    "tsx": "catalog:"
  }
}
